# service-accounts.ldif
# Create LDAP bind service accounts for each application.
# Apply with: ldapmodify -x -H ldap://localhost -D "cn=Directory Manager" -W -f service-accounts.ldif

# AWX bind account
dn: uid=awx-bind,cn=users,cn=accounts,dc=lab,dc=internal
changetype: add
objectClass: account
objectClass: simpleSecurityObject
uid: awx-bind
userPassword: CHANGEME
description: AWX LDAP bind account (read-only)

# GitLab bind account
dn: uid=gitlab-bind,cn=users,cn=accounts,dc=lab,dc=internal
changetype: add
objectClass: account
objectClass: simpleSecurityObject
uid: gitlab-bind
userPassword: CHANGEME
description: GitLab CE LDAP bind account (read-only)

# Grafana bind account
dn: uid=grafana-bind,cn=users,cn=accounts,dc=lab,dc=internal
changetype: add
objectClass: account
objectClass: simpleSecurityObject
uid: grafana-bind
userPassword: CHANGEME
description: Grafana LDAP bind account (read-only)

# Zabbix bind account
dn: uid=zabbix-bind,cn=users,cn=accounts,dc=lab,dc=internal
changetype: add
objectClass: account
objectClass: simpleSecurityObject
uid: zabbix-bind
userPassword: CHANGEME
description: Zabbix LDAP bind account (read-only)

# NetBox bind account
dn: uid=netbox-bind,cn=users,cn=accounts,dc=lab,dc=internal
