# /etc/rancher/rke2/config.yaml
# Generated by Ansible — do not edit manually.

tls-san:
{% for san in rke2_server_config.tls-san %}
  - {{ san }}
{% endfor %}

cni: {{ rke2_server_config.cni | default('canal') }}
profile: {{ rke2_server_config.profile | default('cis-1.23') }}

audit-policy-file: /etc/rancher/rke2/audit-policy.yaml

kube-apiserver-arg:
  - "audit-log-path=/var/log/kubernetes/audit.log"
  - "audit-log-maxage=30"
  - "audit-log-maxbackup=10"
  - "audit-log-maxsize=100"
  - "enable-admission-plugins=NodeRestriction,PodSecurityAdmission"

kube-controller-manager-arg:
  - "terminated-pod-gc-threshold=10"

disable:
  - rke2-ingress-nginx  # We deploy ingress-nginx separately
