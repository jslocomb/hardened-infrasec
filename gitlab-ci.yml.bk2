# .gitlab-ci.yml
# ──────────────────────────────────────────────────────────────────────────────
# GitLab CI Pipeline — Python Security Automation Scripts
#
# Runs on every push and merge request targeting the main branch.
# Stages:
#   1. lint   — flake8 style + syntax check; bandit security analysis
#   2. test   — pytest unit tests for all three automation scripts
#   3. report — upload test results and coverage artifacts
#
# Scripts tested:
#   scripts/aide_to_splunk.py          (AIDE → Splunk HEC ingest)
#   scripts/freeipa_account_auditor.py (FreeIPA stale account detection)
#   scripts/k8s_secret_auditor.py      (K8s audit log anomaly detection)
#
# Requires runner tag: python-runner (shell or docker executor)
# Docker image: python:3.11-slim
# ──────────────────────────────────────────────────────────────────────────────

stages:
  - lint
  - test
  - report

# ─────────────────────────────────────────────────────────────────────────────
# Shared configuration
# ─────────────────────────────────────────────────────────────────────────────

default:
  image: python:3.11-slim
  before_script:
    - pip install --upgrade pip --quiet
    - pip install flake8 bandit pytest pytest-cov --quiet
  cache:
    key: "${CI_COMMIT_REF_SLUG}"
    paths:
      - .cache/pip/

variables:
  PIP_CACHE_DIR: "${CI_PROJECT_DIR}/.cache/pip"
  SCRIPTS_DIR: "scripts"
  TESTS_DIR: "tests"
  PYTHONPATH: "${SCRIPTS_DIR}"

# ─────────────────────────────────────────────────────────────────────────────
# Stage: lint
# ─────────────────────────────────────────────────────────────────────────────

lint:flake8:
  stage: lint
  script:
    - echo "=== flake8 style and syntax check ==="
    # E501: max line length 120 (security scripts have long doc strings)
    # W503: line break before binary operator (allowed per PEP 8 update)
    # E402: module-level import not at top (scripts use sys.path manipulation)
    - flake8
        --max-line-length=120
        --ignore=W503,E402
        --exclude=.git,__pycache__,.cache
        --statistics
        --count
        ${SCRIPTS_DIR}/aide_to_splunk.py
        ${SCRIPTS_DIR}/freeipa_account_auditor.py
        ${SCRIPTS_DIR}/k8s_secret_auditor.py
    - echo "flake8 PASSED"
  allow_failure: false
  rules:
    - if: '$CI_PIPELINE_SOURCE == "push"'
    - if: '$CI_PIPELINE_SOURCE == "merge_request_event"'

lint:bandit:
  stage: lint
  script:
    - echo "=== bandit security linter ==="
    # -ll: report HIGH severity only (avoids noise from test fixtures)
    # -r: recursive
    # -f json: machine-readable output for artifact
    - bandit
        -r ${SCRIPTS_DIR}
        -ll
        -f json
        -o bandit-report.json
        || bandit
             -r ${SCRIPTS_DIR}
             -ll
             -f txt
        # bandit exits non-zero if findings present; show text for readability
    - echo "bandit complete — check bandit-report.json for details"
  artifacts:
    name: "bandit-${CI_COMMIT_SHORT_SHA}"
    paths:
      - bandit-report.json
    expire_in: 7 days
    when: always
  # bandit findings are advisory — do not block the pipeline
  allow_failure: true
  rules:
    - if: '$CI_PIPELINE_SOURCE == "push"'
    - if: '$CI_PIPELINE_SOURCE == "merge_request_event"'

# ─────────────────────────────────────────────────────────────────────────────
# Stage: test
# ─────────────────────────────────────────────────────────────────────────────

test:aide_to_splunk:
  stage: test
  script:
    - echo "=== Unit tests: aide_to_splunk.py ==="
    - pytest
        ${TESTS_DIR}/test_aide_to_splunk.py
        -v
        --tb=short
        --junit-xml=test-results/aide_to_splunk.xml
        --cov=${SCRIPTS_DIR}/aide_to_splunk
        --cov-report=term-missing
        --cov-report=xml:coverage/aide_to_splunk.xml
        --cov-fail-under=70
  coverage: '/TOTAL.*\s+(\d+%)$/'
  artifacts:
    name: "test-aide-${CI_COMMIT_SHORT_SHA}"
    reports:
      junit: test-results/aide_to_splunk.xml
      coverage_report:
        coverage_format: cobertura
        path: coverage/aide_to_splunk.xml
    paths:
      - test-results/
      - coverage/
    expire_in: 30 days
    when: always
  allow_failure: false
  needs:
    - lint:flake8
  rules:
    - if: '$CI_PIPELINE_SOURCE == "push"'
    - if: '$CI_PIPELINE_SOURCE == "merge_request_event"'

test:freeipa_account_auditor:
  stage: test
  script:
    - echo "=== Unit tests: freeipa_account_auditor.py ==="
    - pytest
        ${TESTS_DIR}/test_freeipa_account_auditor.py
        -v
        --tb=short
        --junit-xml=test-results/freeipa_account_auditor.xml
        --cov=${SCRIPTS_DIR}/freeipa_account_auditor
        --cov-report=term-missing
        --cov-report=xml:coverage/freeipa_account_auditor.xml
        --cov-fail-under=70
  coverage: '/TOTAL.*\s+(\d+%)$/'
  artifacts:
    name: "test-freeipa-${CI_COMMIT_SHORT_SHA}"
    reports:
      junit: test-results/freeipa_account_auditor.xml
      coverage_report:
        coverage_format: cobertura
        path: coverage/freeipa_account_auditor.xml
    paths:
      - test-results/
      - coverage/
    expire_in: 30 days
    when: always
  allow_failure: false
  needs:
    - lint:flake8
  rules:
    - if: '$CI_PIPELINE_SOURCE == "push"'
    - if: '$CI_PIPELINE_SOURCE == "merge_request_event"'

test:k8s_secret_auditor:
  stage: test
  script:
    - echo "=== Unit tests: k8s_secret_auditor.py ==="
    - pytest
        ${TESTS_DIR}/test_k8s_secret_auditor.py
        -v
        --tb=short
        --junit-xml=test-results/k8s_secret_auditor.xml
        --cov=${SCRIPTS_DIR}/k8s_secret_auditor
        --cov-report=term-missing
        --cov-report=xml:coverage/k8s_secret_auditor.xml
        --cov-fail-under=70
  coverage: '/TOTAL.*\s+(\d+%)$/'
  artifacts:
    name: "test-k8s-${CI_COMMIT_SHORT_SHA}"
    reports:
      junit: test-results/k8s_secret_auditor.xml
      coverage_report:
        coverage_format: cobertura
        path: coverage/k8s_secret_auditor.xml
    paths:
      - test-results/
      - coverage/
    expire_in: 30 days
    when: always
  allow_failure: false
  needs:
    - lint:flake8
  rules:
    - if: '$CI_PIPELINE_SOURCE == "push"'
    - if: '$CI_PIPELINE_SOURCE == "merge_request_event"'

test:all:
  stage: test
  script:
    - echo "=== Full suite: all scripts combined ==="
    - pytest
        ${TESTS_DIR}/
        -v
        --tb=short
        --junit-xml=test-results/all.xml
        --cov=${SCRIPTS_DIR}
        --cov-report=term-missing
        --cov-report=html:coverage/html/
        --cov-report=xml:coverage/all.xml
        -q
    - echo "All tests passed"
  coverage: '/TOTAL.*\s+(\d+%)$/'
  artifacts:
    name: "test-all-${CI_COMMIT_SHORT_SHA}"
    reports:
      junit: test-results/all.xml
      coverage_report:
        coverage_format: cobertura
        path: coverage/all.xml
    paths:
      - test-results/
      - coverage/
    expire_in: 30 days
    when: always
  allow_failure: false
  needs:
    - lint:flake8
  rules:
    - if: '$CI_PIPELINE_SOURCE == "push"'
    - if: '$CI_PIPELINE_SOURCE == "merge_request_event"'

# ─────────────────────────────────────────────────────────────────────────────
# Stage: report
# ─────────────────────────────────────────────────────────────────────────────

report:summary:
  stage: report
  script:
    - echo "=== Pipeline Summary ==="
    - echo "Commit: ${CI_COMMIT_SHORT_SHA} on ${CI_COMMIT_REF_NAME}"
    - echo "Pipeline: ${CI_PIPELINE_URL}"
    - |
      if [ -f test-results/all.xml ]; then
        # Print a human-readable test summary from JUnit XML
        python3 -c "
      import xml.etree.ElementTree as ET
      tree = ET.parse('test-results/all.xml')
      root = tree.getroot()
      suite = root if root.tag == 'testsuite' else root.find('testsuite')
      if suite is not None:
          tests = suite.get('tests', '?')
          failures = suite.get('failures', '0')
          errors = suite.get('errors', '0')
          skipped = suite.get('skipped', '0')
          elapsed = suite.get('time', '?')
          print(f'Tests: {tests} | Failures: {failures} | Errors: {errors} | Skipped: {skipped} | Time: {elapsed}s')
      "
      fi
    - echo "=== Done ==="
  needs:
    - test:all
  rules:
    - if: '$CI_PIPELINE_SOURCE == "push"'
    - if: '$CI_PIPELINE_SOURCE == "merge_request_event"'
  when: always

# ─────────────────────────────────────────────────────────────────────────────
# Optional: scheduled full audit (weekly, not on every push)
# ─────────────────────────────────────────────────────────────────────────────

test:scheduled-full:
  stage: test
  script:
    - echo "=== Scheduled full security audit ==="
    - pip install pytest pytest-cov flake8 bandit --quiet
    - flake8 ${SCRIPTS_DIR}/ --max-line-length=120 --ignore=W503,E402
    - bandit -r ${SCRIPTS_DIR}/ -f txt || true
    - pytest ${TESTS_DIR}/ -v --tb=long --cov=${SCRIPTS_DIR} --cov-report=term
  rules:
    - if: '$CI_PIPELINE_SOURCE == "schedule"'
  allow_failure: false
